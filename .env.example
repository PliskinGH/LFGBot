# Environment template: copy to .env and uncomment the variables you set.
#
# Every line below is commented out on purpose. The bot and the web admin load
# .env with override=true, so a variable present but empty would shadow the
# real value a deployed host provides.

## Bot

# The bot token. Required.
#DISCORD_TOKEN=

# Guild configuration database. Without it the bot only uses the config/ files.
#DATABASE_URL=postgres://user:password@host/dbname

## Web admin panel (see the README)

# It edits the database, so it requires DATABASE_URL above.

# Its login authorizes the bot's own Discord application (scopes: identify,
# guilds).
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=

# Its public address. Required in production; an https:// one turns on the
# HTTPS redirect and the secure session cookie.
#WEB_BASE_URL=https://lfg.example.com

# The login callback registered on the application. Defaults to
# <WEB_BASE_URL>/discord/callback.
#DISCORD_REDIRECT_URI=https://lfg.example.com/discord/callback

# Signs the session cookie. Without it, restarts log every visitor out.
#SESSION_SECRET=

# Hostnames the web admin answers for; empty accepts every one.
#TRUSTED_HOSTS=lfg.example.com

# Login lifetime in seconds; defaults to 28800 (8 hours).
#SESSION_MAX_AGE=28800

# Discord ids allowed to edit every server and the [DEFAULT] configuration
# (space, comma or semicolon separated).
#OPERATOR_DISCORD_IDS=

## Development

# Sync slash commands to these guild ids (comma-separated) instead of
# globally, to speed up restarts while developing.
#TEST_GUILD_ID=

## Test suite

# The db suites skip themselves without it.
#TEST_DATABASE_URL=postgres://user:password@host/test_dbname
